# Supabase — copiar este archivo a .env.local y rellenar con los valores
# del panel de Supabase: Project Settings > API

# URL del proyecto (p. ej. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (segura para el navegador, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" (SOLO backend — nunca exponer en el cliente).
# Necesaria para el panel de admin y la lectura de roles.
SUPABASE_SERVICE_ROLE_KEY=
