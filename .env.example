# Firebase — copiar este archivo a .env.local y rellenar con los valores
# de la consola de Firebase (https://console.firebase.google.com)

# Configuración web (Project Settings > General > Your apps > SDK setup and configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cuenta de servicio (SOLO backend — nunca exponer en el cliente).
# Project Settings > Service accounts > Generate new private key.
# Pegar el JSON completo descargado, en una sola línea.
FIREBASE_SERVICE_ACCOUNT=
